# Generated by Cargo
# will have compiled files and executables
debug/
target/

# Sass cache (generated by dart-sass)
.sass-cache/

# SQLite database files (local development data)
*.db
*.db-wal
*.db-shm

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# IDE / Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
